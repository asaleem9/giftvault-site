{
  "name": "giftvault-hyperframes",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "for p in drawer-to-stack launch-film widgets-loop wallet-loop; do (cd $p && npx --yes hyperframes@0.8.192 check); done",
    "preview:drawer": "cd drawer-to-stack && npx --yes hyperframes@0.8.192 preview",
    "preview:film": "cd launch-film && npx --yes hyperframes@0.8.192 preview",
    "preview:widgets": "cd widgets-loop && npx --yes hyperframes@0.8.192 preview",
    "preview:wallet": "cd wallet-loop && npx --yes hyperframes@0.8.192 preview"
  }
}
